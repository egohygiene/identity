{
  "$schema": "../../../../../../contracts/v1/tokens.schema.json",
  "$description": "Draft Identity-only token baseline for review, preserving the publication configuration at afc368003bfc6a2101051229efd237c8d6fadf71. Not an approved organization standard or adopted source layer. The publication role color.text is represented as color.text.default in this candidate; see README.md.",
  "$extensions": {
    "org.egohygiene.identity": {
      "schema": "identity.tokens/v1"
    }
  },
  "color": {
    "$type": "color",
    "brand": {
      "primary": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.4157, 0.298, 1],
          "alpha": 1
        }
      },
      "secondary": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.4314, 0.6588, 1],
          "alpha": 1
        }
      }
    },
    "canvas": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0392, 0.0392, 0.0549],
        "alpha": 1
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1176, 0.1059, 0.149],
        "alpha": 1
      }
    },
    "text": {
      "default": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.949, 0.9373, 0.9137],
          "alpha": 1
        }
      },
      "muted": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.8039, 0.7294, 0.6039],
          "alpha": 1
        }
      }
    },
    "border": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.7373, 0.6627, 1],
        "alpha": 0.42
      }
    }
  },
  "typography": {
    "body": {
      "family": {
        "$type": "fontFamily",
        "$value": ["Inter", "system-ui", "sans-serif"]
      }
    },
    "heading": {
      "family": {
        "$type": "fontFamily",
        "$value": ["Inter", "system-ui", "sans-serif"]
      }
    }
  }
}
