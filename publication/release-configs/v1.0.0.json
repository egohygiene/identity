  "guidance": {
    "voice": {
      "status": "declared",
      "canonical": true,
      "value": {
        "principles": [
          "Clarity in form.",
          "Alignment in purpose.",
          "Essence in everything."
        ],
        "character": ["clear", "precise", "present"]
      }
    },
    "usage": {
      "status": "declared",
      "canonical": true,
      "value": {
        "do": [
          "Preserve the declared clear space around the approved mark.",
          "Use the approved dark or neutral background behavior."
        ],
        "dont": [
          "Place the mark on busy or low-contrast backgrounds.",
          "Treat an unapproved candidate as a published asset."
        ]
      }
    }
