{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/identity/contracts/v1/brand-guidance.schema.json",
  "title": "Identity v1 renderer-ready brand guidance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "audience",
    "project",
    "selectedContext",
    "foundation",
    "characteristics",
    "contexts",
    "localization",
    "sections",
    "doDont",
    "downloads",
    "legacyAssets",
    "accessibility",
    "legal",
    "decisions"
  ],
  "properties": {
    "schema": { "const": "identity.brand-guidance/v1" },
    "audience": { "enum": ["public", "review"] },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "tagline", "repository"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "tagline": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 }
      }
    },
    "selectedContext": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1 }
      ]
    },
    "foundation": {
      "oneOf": [
        { "$ref": "voice.schema.json#/$defs/foundation" },
        { "type": "null" }
      ]
    },
    "characteristics": {
      "type": "array",
      "items": { "$ref": "voice.schema.json#/$defs/characteristic" }
    },
    "contexts": {
      "type": "array",
      "items": { "$ref": "#/$defs/projectedContext" }
    },
    "localization": {
      "oneOf": [
        { "$ref": "voice.schema.json#/$defs/localization" },
        { "type": "null" }
      ]
    },
    "sections": {
      "type": "array",
      "items": { "$ref": "usage.schema.json#/$defs/section" }
    },
    "doDont": {
      "type": "array",
      "items": { "$ref": "usage.schema.json#/$defs/rule" }
    },
    "downloads": {
      "type": "array",
      "items": { "$ref": "usage.schema.json#/$defs/asset" }
    },
    "legacyAssets": {
      "type": "array",
      "items": { "$ref": "usage.schema.json#/$defs/asset" }
    },
    "accessibility": {
      "oneOf": [
        { "$ref": "usage.schema.json#/$defs/accessibility" },
        { "type": "null" }
      ]
    },
    "legal": {
      "oneOf": [
        { "$ref": "usage.schema.json#/$defs/legal" },
        { "type": "null" }
      ]
    },
    "decisions": {
      "type": "array",
      "items": { "$ref": "approvals.schema.json#/$defs/decision" }
    }
  },
  "$defs": {
    "projectedContext": {
      "description": "A public projection can have no surviving characteristic references or examples. Review retains the complete source context.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "audience",
        "intent",
        "tone",
        "characteristics",
        "preferredVocabulary",
        "avoidedLanguage",
        "naming",
        "capitalization",
        "punctuation",
        "examples",
        "antiExamples",
        "governance"
      ],
      "properties": {
        "id": {
          "$ref": "voice.schema.json#/$defs/context/properties/id"
        },
        "label": {
          "$ref": "voice.schema.json#/$defs/context/properties/label"
        },
        "audience": {
          "$ref": "voice.schema.json#/$defs/context/properties/audience"
        },
        "intent": {
          "$ref": "voice.schema.json#/$defs/context/properties/intent"
        },
        "tone": {
          "$ref": "voice.schema.json#/$defs/context/properties/tone"
        },
        "characteristics": {
          "type": "array",
          "items": {
            "$ref": "voice.schema.json#/$defs/nonEmptyStrings/items"
          }
        },
        "preferredVocabulary": {
          "$ref": "voice.schema.json#/$defs/context/properties/preferredVocabulary"
        },
        "avoidedLanguage": {
          "$ref": "voice.schema.json#/$defs/context/properties/avoidedLanguage"
        },
        "naming": {
          "$ref": "voice.schema.json#/$defs/context/properties/naming"
        },
        "capitalization": {
          "$ref": "voice.schema.json#/$defs/context/properties/capitalization"
        },
        "punctuation": {
          "$ref": "voice.schema.json#/$defs/context/properties/punctuation"
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "voice.schema.json#/$defs/context/properties/examples/items"
          }
        },
        "antiExamples": {
          "type": "array",
          "items": {
            "$ref": "voice.schema.json#/$defs/context/properties/antiExamples/items"
          }
        },
        "governance": {
          "$ref": "voice.schema.json#/$defs/context/properties/governance"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "audience": {
            "const": "review"
          }
        }
      },
      "then": {
        "properties": {
          "foundation": {
            "$ref": "voice.schema.json#/$defs/foundation"
          },
          "localization": {
            "$ref": "voice.schema.json#/$defs/localization"
          },
          "accessibility": {
            "$ref": "usage.schema.json#/$defs/accessibility"
          },
          "legal": {
            "$ref": "usage.schema.json#/$defs/legal"
          },
          "contexts": {
            "type": "array",
            "items": {
              "$ref": "voice.schema.json#/$defs/context"
            }
          }
        }
      }
    }
  ]
}
