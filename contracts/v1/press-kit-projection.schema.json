{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/identity/contracts/v1/press-kit-projection.schema.json",
  "title": "Identity v1 generated Press Kit and Media Kit projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project", "source", "inheritance", "boilerplates", "facts", "links", "contacts", "team", "assets", "guidance", "artifacts"],
  "properties": {
    "schema": { "const": "identity.press-kit/v1" },
    "project": { "$ref": "#/$defs/project" },
    "source": { "$ref": "#/$defs/source" },
    "inheritance": { "$ref": "#/$defs/inheritance" },
    "boilerplates": { "type": "array", "items": { "$ref": "#/$defs/boilerplate" } },
    "facts": { "type": "array", "items": { "$ref": "#/$defs/fact" } },
    "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
    "contacts": { "type": "array", "items": { "$ref": "#/$defs/contact" } },
    "team": { "type": "array", "items": { "$ref": "#/$defs/teamMember" } },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } },
    "guidance": { "$ref": "#/$defs/guidance" },
    "artifacts": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/artifact" } }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "repository", "tagline", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "pattern": "^https://[^\\s]+$" },
        "tagline": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["organization", "product", "repository"] }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "sourceSchema", "projectionVersion"],
      "properties": {
        "digest": { "$ref": "#/$defs/digest" },
        "sourceSchema": { "const": "identity.press-kit-source/v1" },
        "projectionVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "inheritance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organizationLayers", "productLayer", "overrides"],
      "properties": {
        "organizationLayers": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "productLayer": { "type": "string", "minLength": 1 },
        "overrides": { "type": "array", "items": { "$ref": "#/$defs/override" } }
      }
    },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token", "reason", "approval"],
      "properties": {
        "token": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "approval": { "type": "string", "minLength": 1 }
      }
    },
    "approvalRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 }
      }
    },
    "boilerplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "text", "approval"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["short", "long"] },
        "text": { "type": "string", "minLength": 1 },
        "approval": { "$ref": "#/$defs/approvalRecord" }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "value", "approval"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "approval": { "$ref": "#/$defs/approvalRecord" }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "url", "kind", "approval"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://[^\\s]+$" },
        "kind": { "type": "string", "minLength": 1 },
        "approval": { "$ref": "#/$defs/approvalRecord" }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "value", "notes", "approval"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" },
        "approval": { "$ref": "#/$defs/approvalRecord" }
      }
    },
    "teamMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "role", "approval"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "bio": { "type": "string" },
        "approval": { "$ref": "#/$defs/approvalRecord" }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "status", "attribution"],
      "properties": {
        "spdx": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "attribution": { "type": "string" }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["creator", "method", "source", "capturedAt"],
      "properties": {
        "creator": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "capturedAt": { "type": "string", "minLength": 1 }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "assetId", "label", "notes", "downloadPath", "mediaType", "sha256", "altText", "license", "origin", "usage", "approval"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "assetId": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "notes": { "type": "string", "minLength": 1 },
        "downloadPath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" },
        "mediaType": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/digest" },
        "altText": { "type": "string", "minLength": 1 },
        "license": { "$ref": "#/$defs/license" },
        "origin": { "$ref": "#/$defs/origin" },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["safeZone", "minimumSize", "restrictions"],
          "properties": {
            "safeZone": { "type": "string" },
            "minimumSize": { "type": "string" },
            "restrictions": { "type": "array", "items": { "type": "string" } }
          }
        },
        "approval": { "$ref": "#/$defs/approvalRecord" }
      }
    },
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["usageRules", "legal"],
      "properties": {
        "usageRules": { "type": "array", "items": { "type": "object" } },
        "legal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {
            "status": { "enum": ["declared", "not-declared"] },
            "value": {}
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "path", "mediaType", "intendedUse"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "mediaType": { "type": "string", "minLength": 1 },
        "intendedUse": { "type": "string", "minLength": 1 }
      }
    }
  }
}
