{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.egohygiene.io/identity/brand-kit-view-model/v1.json",
  "title": "Identity Brand Kit reference-renderer view model v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "projectId",
    "project",
    "release",
    "tokens",
    "assets",
    "guidance",
    "support",
    "packages"
  ],
  "properties": {
    "schema": {
      "const": "identity.brand-kit-view-model/v1"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "release": {
      "$ref": "#/$defs/release"
    },
    "tokens": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/token"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "guidance": {
      "$ref": "#/$defs/guidance"
    },
    "support": {
      "$ref": "#/$defs/support"
    },
    "designSystem": {
      "$ref": "#/$defs/designSystem"
    },
    "pressKit": {
      "$ref": "#/$defs/pressKit"
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package"
      }
    },
    "downloads": {
      "description": "Selected public generated artifacts. The native GitHub Social preview artifact is described by $defs.githubSocialPreviewDownload; other existing downloads remain valid.",
      "type": "array",
      "items": { "$ref": "#/$defs/download" }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "declared",
        "not-declared",
        "unsupported"
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "displayName",
        "repository",
        "tagline"
      ],
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "tagline": {
          "type": "string"
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "profileVersion",
        "sourceDigest",
        "immutableId",
        "status"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "profileVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "sourceDigest": {
          "$ref": "#/$defs/digest"
        },
        "immutableId": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "generated",
            "approved",
            "published",
            "superseded"
          ]
        }
      }
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "type",
        "value",
        "sourceLayer"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "sourceLayer": {
          "type": "string",
          "minLength": 1
        },
        "overrideReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "approval": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spdx",
        "status",
        "attribution"
      ],
      "properties": {
        "spdx": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "attribution": {
          "type": "string"
        }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "creator",
        "method",
        "source",
        "capturedAt"
      ],
      "properties": {
        "creator": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "capturedAt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assetUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["safeZone", "minimumSize", "restrictions"],
      "properties": {
        "safeZone": { "type": "string", "minLength": 1 },
        "minimumSize": { "type": "string", "minLength": 1 },
        "restrictions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "mediaType",
        "sha256",
        "altText",
        "dimensions",
        "intendedUse",
        "text",
        "availability"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "altText": {
          "type": "string",
          "minLength": 1
        },
        "dimensions": {
          "type": "string",
          "minLength": 1
        },
        "intendedUse": {
          "type": "string",
          "minLength": 1
        },
        "safeZone": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "text": {
          "type": "string"
        },
        "availability": {
          "type": "string",
          "enum": [
            "generated-download",
            "embedded-source"
          ]
        },
        "downloadPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "license": {
          "oneOf": [
            {
              "$ref": "#/$defs/license"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "oneOf": [
            {
              "$ref": "#/$defs/origin"
            },
            {
              "type": "null"
            }
          ]
        },
        "approval": {
          "type": [
            "string",
            "null"
          ]
        },
        "usage": {
          "oneOf": [
            { "$ref": "#/$defs/assetUsage" },
            { "type": "null" }
          ]
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "download": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "path", "mediaType", "profile", "sourceAssetId", "sourceSha256", "dimensions"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*\/$)[^\\u0000]+$"
        },
        "mediaType": { "type": "string", "minLength": 1 },
        "profile": { "type": "string", "minLength": 1 },
        "sourceAssetId": { "type": "string", "minLength": 1 },
        "sourceSha256": { "$ref": "#/$defs/digest" },
        "dimensions": { "type": "string", "minLength": 1 }
      }
    },
    "githubSocialPreviewDownload": {
      "title": "Native GitHub repository Social preview artifact",
      "description": "The existing github@1.0.0 output for repository Settings > Social preview: 1280 by 640 PNG, with a native compiler budget of 999999 bytes. The repository retains its layout reference at docs/references/github/repository-open-graph-template.png. This additive named specialization introduces no new source or download fields.",
      "allOf": [
        { "$ref": "#/$defs/download" },
        {
          "properties": {
            "id": { "const": "github-social-preview" },
            "profile": { "const": "github" },
            "path": { "const": "github/social-preview.png" },
            "mediaType": { "const": "image/png" },
            "dimensions": { "const": "1280 × 640 pixels" }
          }
        }
      ]
    },
    "guidanceSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "canonical"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "canonical": {
          "const": true
        },
        "value": {}
      }
    },
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "voice",
        "usage"
      ],
      "properties": {
        "voice": {
          "$ref": "#/$defs/guidanceSection"
        },
        "usage": {
          "$ref": "#/$defs/guidanceSection"
        }
      }
    },
    "supportSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "motion",
        "imagery",
        "mascot"
      ],
      "properties": {
        "motion": {
          "$ref": "#/$defs/supportSection"
        },
        "imagery": {
          "$ref": "#/$defs/supportSection"
        },
        "mascot": {
          "$ref": "#/$defs/supportSection"
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "path",
        "mediaType",
        "intendedUse"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "intendedUse": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "designSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handbook", "context", "artifacts"],
      "properties": {
        "handbook": {
          "type": "object",
          "required": ["schema", "project", "sections", "capabilities"],
          "properties": {
            "schema": { "const": "identity.design-system-handbook/v1" },
            "project": {
              "type": "object",
              "required": ["id", "displayName"]
            },
            "sections": { "type": "array" },
            "capabilities": { "type": "array" }
          }
        },
        "context": {
          "type": "object",
          "required": ["schema", "project", "source", "tokens"],
          "properties": {
            "schema": { "const": "identity.design-context/v1" },
            "project": {
              "type": "object",
              "required": ["id", "displayName"]
            },
            "source": {
              "type": "object",
              "required": ["digest", "handbookSchema"]
            },
            "tokens": { "type": "array" }
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "required": ["id", "label", "path", "mediaType"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "path": { "type": "string" },
              "mediaType": { "type": "string" }
            }
          }
        }
      }
    },
    "pressKit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pressKit", "artifacts"],
      "properties": {
        "pressKit": {
          "type": "object",
          "required": [
            "schema",
            "project",
            "source",
            "boilerplates",
            "facts",
            "links",
            "contacts",
            "team",
            "assets",
            "guidance",
            "artifacts"
          ],
          "properties": {
            "schema": { "const": "identity.press-kit/v1" },
            "project": {
              "type": "object",
              "required": ["id", "displayName"]
            },
            "source": {
              "type": "object",
              "required": ["digest", "sourceSchema"]
            },
            "boilerplates": { "type": "array" },
            "facts": { "type": "array" },
            "links": { "type": "array" },
            "contacts": { "type": "array" },
            "team": { "type": "array" },
            "assets": { "type": "array" },
            "guidance": { "type": "object" },
            "artifacts": { "type": "array", "minItems": 5 }
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "required": ["id", "label", "path", "mediaType"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "path": { "type": "string" },
              "mediaType": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
