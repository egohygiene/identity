{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/identity/contracts/v1/repository-presentation-package-manifest.schema.json",
  "title": "Identity v1 repository-presentation package integrity manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "projectionSchema", "projectId", "sourceDigest", "profile", "evidence", "files"],
  "properties": {
    "schema": { "const": "identity.repository-presentation-package-manifest/v1" },
    "version": { "const": "1.0.0" },
    "projectionSchema": { "const": "identity.repository-presentation-package/v1" },
    "projectId": { "type": "string", "minLength": 1 },
    "sourceDigest": { "$ref": "#/$defs/sha256" },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "status", "commit", "digest"],
      "properties": {
        "id": { "const": "egohygiene.repository-presentation-profile/v1" },
        "version": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "representedCommit", "url", "digest"],
      "properties": {
        "state": { "type": "string", "minLength": 1 },
        "representedCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "url": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "bytes", "mediaType"],
        "properties": {
          "sha256": { "$ref": "#/$defs/sha256" },
          "bytes": { "type": "integer", "minimum": 0 },
          "mediaType": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
