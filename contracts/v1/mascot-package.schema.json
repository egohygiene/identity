{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/identity/contracts/v1/mascot-package.schema.json",
  "title": "Identity v1 mascot package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema", "character", "version", "derivedFrom", "generation", "guidance", "license", "files"],
  "properties": {
    "$schema": { "type": "string", "pattern": "(^|/)mascot-package.schema.json$" },
    "schema": { "const": "identity.mascot-package/v1" },
    "character": { "$ref": "#/$defs/identifier" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "derivedFrom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "tool", "record"],
      "properties": {
        "mode": { "const": "reviewed-byte-bound-projection" },
        "tool": { "type": "string", "minLength": 1 },
        "record": { "$ref": "#/$defs/relativePath" }
      }
    },
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "attribution"],
      "properties": {
        "spdx": { "type": "string", "minLength": 1 },
        "attribution": { "type": "string", "minLength": 1 }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "mediaType", "width", "height", "sizeBytes", "sha256", "role", "minimumWidth"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "path": { "$ref": "#/$defs/relativePath" },
          "mediaType": { "const": "image/png" },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "sizeBytes": { "type": "integer", "minimum": 1 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "role": { "type": "string", "minLength": 1 },
          "minimumWidth": { "type": "integer", "minimum": 1 }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*\/$)[^\\u0000]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
