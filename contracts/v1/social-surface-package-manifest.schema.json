{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/identity/contracts/v1/social-surface-package-manifest.schema.json",
  "title": "Identity v1 social-surface package integrity manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "projectionSchema", "projectId", "sourceDigest", "catalog", "files"],
  "properties": {
    "schema": { "const": "identity.social-surface-package-manifest/v1" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "projectionSchema": { "const": "identity.social-surface-package/v1" },
    "projectId": { "type": "string", "minLength": 1 },
    "sourceDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "bytes"],
        "properties": {
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
