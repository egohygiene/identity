{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/identity/contracts/v1/initialization-report.schema.json",
  "title": "Identity v1 initialization candidate report",
  "description": "Candidate preparation evidence, never approval, canonical adoption or release/producer qualification.",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "status", "sourceValid", "missing", "diagnostics", "implementation", "compatibility", "inputs", "files", "directories", "limitations"],
  "properties": {
    "schema": {"const": "identity.initialization-report/v1"},
    "status": {"enum": ["incomplete", "ready-for-review"]},
    "sourceValid": {"type": "boolean"},
    "missing": {"type": "array", "items": {"type": "string"}},
    "diagnostics": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["code", "path", "severity", "message", "recovery"],
        "properties": {
          "code": {"type": "string"}, "path": {"type": "string"},
          "severity": {"enum": ["error", "warning"]},
          "message": {"type": "string"}, "recovery": {"type": "string"}
        }
      }
    },
    "implementation": {
      "type": "object", "additionalProperties": false,
      "required": ["packageVersion", "initializerSha256", "validatorSha256"],
      "properties": {
        "packageVersion": {"type": "string"},
        "initializerSha256": {"$ref": "#/$defs/sha256"},
        "validatorSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "compatibility": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceSchema", "acceptedSchemaMajor", "availableProfiles"],
      "properties": {
        "sourceSchema": {"const": "identity.project/v1"},
        "acceptedSchemaMajor": {"const": 1},
        "availableProfiles": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}}
      }
    },
    "inputs": {"$ref": "#/$defs/inventory"},
    "files": {"$ref": "#/$defs/inventory"},
    "directories": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inventory": {
      "type": "object", "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["sha256", "bytes"],
        "properties": {"sha256": {"$ref": "#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 0}}
      }
    }
  }
}
