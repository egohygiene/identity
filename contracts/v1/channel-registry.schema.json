{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/identity/contracts/v1/channel-registry.schema.json",
  "title": "Identity v1 organization channel registry source",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema", "registry", "security", "channels"],
  "properties": {
    "$schema": { "type": "string", "pattern": "(^|/)channel-registry.schema.json$" },
    "schema": { "const": "identity.channel-registry-source/v1" },
    "registry": { "$ref": "#/$defs/registry" },
    "security": { "$ref": "#/$defs/security" },
    "channels": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/channel" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "owner", "reviewedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "owner": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "format": "date-time" }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secretsStored", "ownerReferenceKind", "procedureLocation"],
      "properties": {
        "secretsStored": { "const": false },
        "ownerReferenceKind": { "const": "role" },
        "procedureLocation": { "type": "string", "minLength": 1 }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "platform", "canonicalUrl", "handle", "ownershipEntity", "verification", "lifecycle", "audiencePurpose", "contentScope", "locale", "accessibility", "recoveryOwner", "badge", "governance"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "platform": { "$ref": "#/$defs/platform" },
        "canonicalUrl": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/httpsUrl" }]
        },
        "handle": { "type": ["string", "null"], "minLength": 1 },
        "ownershipEntity": { "type": "string", "minLength": 1 },
        "verification": { "$ref": "#/$defs/verification" },
        "lifecycle": { "$ref": "#/$defs/lifecycle" },
        "audiencePurpose": { "type": "string", "minLength": 1 },
        "contentScope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "locale": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" }
        },
        "accessibility": { "$ref": "#/$defs/accessibility" },
        "recoveryOwner": { "type": "string", "minLength": 1 },
        "badge": { "$ref": "#/$defs/badge" },
        "governance": { "$ref": "#/$defs/governance" }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "evidence"],
      "properties": {
        "state": { "enum": ["unverified", "pending", "verified", "not-applicable"] },
        "evidence": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/httpsUrl" }]
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "since", "notes"],
      "properties": {
        "state": { "enum": ["planned", "reserved", "active", "unavailable", "deprecated", "impersonation-risk"] },
        "since": { "type": "string", "format": "date" },
        "notes": { "type": "string" }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "contactNotes"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "contactNotes": { "type": "string" }
      }
    },
    "badge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "label", "icon"],
      "properties": {
        "approved": { "type": "boolean" },
        "label": { "type": "string", "minLength": 1 },
        "icon": { "$ref": "#/$defs/icon" }
      }
    },
    "icon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "license"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "source": { "$ref": "#/$defs/httpsUrl" },
        "license": { "type": "string", "minLength": 1 }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "state", "visibility", "provenance", "approval"],
      "properties": {
        "subject": { "type": "string", "minLength": 1 },
        "state": { "enum": ["candidate", "approved", "rejected", "superseded"] },
        "visibility": { "enum": ["public", "internal"] },
        "provenance": { "$ref": "#/$defs/provenance" },
        "approval": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/identifier" }]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "source", "capturedAt"],
      "properties": {
        "method": { "enum": ["human-authored", "imported"] },
        "source": { "type": "string", "minLength": 1 },
        "capturedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
