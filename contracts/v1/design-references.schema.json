{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.github.io/identity/contracts/v1/design-references.schema.json",
  "title": "Identity v1 reviewed design-system reference catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema", "references"],
  "properties": {
    "$schema": { "type": "string", "pattern": "(^|/)design-references.schema.json$" },
    "schema": { "const": "identity.design-reference-catalog/v1" },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/reference" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "source", "capturedAt"],
      "properties": {
        "method": { "enum": ["human-authored", "handoff-candidate", "imported"] },
        "source": { "type": "string", "minLength": 1 },
        "capturedAt": { "type": "string", "format": "date-time" }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "state", "visibility", "provenance", "approval"],
      "properties": {
        "subject": { "type": "string", "minLength": 1 },
        "state": { "enum": ["candidate", "approved", "rejected", "superseded"] },
        "visibility": { "enum": ["public", "internal"] },
        "provenance": { "$ref": "#/$defs/provenance" },
        "approval": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/identifier" }
          ]
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "url",
        "capturedAt",
        "patterns",
        "decision",
        "notes",
        "rights",
        "affectsCanonical",
        "governance"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "url": { "type": "string", "pattern": "^https://[^\\s]+$" },
        "capturedAt": { "type": "string", "format": "date-time" },
        "patterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "decision": { "enum": ["adopt", "adapt", "reject", "observe"] },
        "notes": { "type": "string", "minLength": 1 },
        "rights": { "type": "string", "minLength": 1 },
        "affectsCanonical": { "type": "boolean" },
        "governance": { "$ref": "#/$defs/governance" }
      }
    }
  }
}
