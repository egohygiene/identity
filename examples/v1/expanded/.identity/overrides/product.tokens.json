{
  "$schema": "../../../../../contracts/v1/tokens.schema.json",
  "$extensions": {
    "org.egohygiene.identity": {
      "schema": "identity.tokens/v1",
      "layer": {
        "id": "example-expanded",
        "kind": "product-override",
        "priority": 10
      }
    }
  },
  "color": {
    "$type": "color",
    "brand": {
      "primary": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.42,
            0.2,
            0.72
          ],
          "alpha": 1
        },
        "$extensions": {
          "org.egohygiene.identity": {
            "override": {
              "reason": "Demonstrate a reviewed product accent within a shared organization palette.",
              "approval": "example-color-approval"
            }
          }
        }
      }
    },
    "action": {
      "primary": {
        "$value": "{color.brand.primary}"
      }
    }
  }
}
