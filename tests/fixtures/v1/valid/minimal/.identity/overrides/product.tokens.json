{
  "$schema": "../../../../../../../contracts/v1/tokens.schema.json",
  "$description": "Example product-level semantic differences.",
  "$extensions": {
    "org.egohygiene.identity": {
      "schema": "identity.tokens/v1",
      "layer": {
        "id": "example-product",
        "kind": "product-override",
        "priority": 10
      }
    }
  },
  "color": {
    "$type": "color",
    "brand": {
      "primary": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.42, 0.2, 0.72],
          "alpha": 1
        },
        "$description": "Intentional product accent within the family system.",
        "$extensions": {
          "org.egohygiene.identity": {
            "override": {
              "reason": "Give the product a distinct violet technical accent.",
              "approval": "approve-product-primary"
            },
            "contrast": {
              "intent": "decorative",
              "pairedWith": [],
              "minimumRatio": 1
            }
          }
        }
      }
    },
    "action": {
      "primary": {
        "$value": "{color.brand.primary}"
      }
    }
  }
}
