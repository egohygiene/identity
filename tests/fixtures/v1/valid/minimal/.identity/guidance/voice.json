  "contexts": [
    {
      "id": "repository-readme",
      "label": "Repository README",
      "audience": "A contributor deciding whether and how to use the repository.",
      "intent": "Orient quickly, establish trust, and make the next action obvious.",
      "tone": "Concise, capable, welcoming, and specific.",
      "characteristics": ["clear", "grounded", "considerate"],
      "preferredVocabulary": ["reviewed", "local", "deterministic", "evidence", "recovery"],
      "avoidedLanguage": ["magic", "revolutionary", "effortless", "guaranteed"],
      "naming": "Use the complete product name on first mention and the approved short name afterward.",
      "capitalization": "Use sentence case for headings and preserve registered product casing.",
      "punctuation": "Prefer short declarative sentences; use exclamation points only for genuine celebration.",
      "examples": [
        {
          "id": "readme-opening",
          "text": "Generate a reviewed Brand Kit locally, then inspect exactly what changed.",
          "rationale": "It states the outcome, authority boundary, and recovery affordance without hype.",
          "governance": {
            "subject": "voice:core-guidance",
            "state": "approved",
            "visibility": "public",
            "provenance": {
              "method": "human-authored",
              "source": ".identity/brief.md",
              "capturedAt": "2026-08-21T12:10:00Z"
            },
            "approval": "approve-voice-core"
          }
        },
        {
          "id": "friendly-candidate",
          "text": "Your brand system, ready when you are.",
          "rationale": "A warmer option proposed through the creative handoff and awaiting review.",
          "governance": {
            "subject": "voice-example:friendly-candidate",
            "state": "candidate",
            "visibility": "internal",
            "provenance": {
              "method": "handoff-candidate",
              "source": "handoff:voice-friendly-candidate/v1",
              "capturedAt": "2026-08-21T12:18:00Z"
            },
            "approval": null
          }
        },
        {
          "id": "old-tagline",
          "text": "Branding solved forever.",
          "rationale": "Retained as superseded migration history and excluded from current public copy.",
          "governance": {
            "subject": "voice-example:old-tagline",
            "state": "superseded",
            "visibility": "internal",
            "provenance": {
              "method": "imported",
              "source": "guidance:old-tagline/v0",
              "capturedAt": "2025-02-01T10:00:00Z"
            },
            "approval": "supersede-old-tagline"
          }
        }
      ],
      "antiExamples": [
        {
          "id": "readme-vagueness",
          "text": "A flexible solution for all your branding needs.",
          "rationale": "It names neither a concrete outcome nor the system's review boundary.",
          "governance": {
            "subject": "voice:core-guidance",
            "state": "approved",
            "visibility": "public",
            "provenance": {
              "method": "human-authored",
              "source": ".identity/brief.md",
