            "visibility": "internal",
            "provenance": {
              "method": "handoff-candidate",
              "source": "handoff:voice-hype-claim/v1",
              "capturedAt": "2026-08-21T12:19:00Z"
            },
            "approval": "reject-hype-claim"
          }
        }
      ],
      "governance": {
        "subject": "voice:core-guidance",
        "state": "approved",
        "visibility": "public",
        "provenance": {
          "method": "human-authored",
