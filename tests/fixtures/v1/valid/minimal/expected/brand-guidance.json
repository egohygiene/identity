    {
      "description": "Keep approved marks legible, proportionate, and visually independent.",
      "id": "marks",
      "rules": [
        {
          "category": "mark",
          "contexts": [
            "repository-readme",
            "product-ui",
            "social-card"
          ],
          "details": [
            "Minimum standalone size: 16 CSS pixels",
            "Preferred backgrounds: surface canvas or brand primary"
