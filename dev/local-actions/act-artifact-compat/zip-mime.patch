+func TestIdentityCreateArtifactMIMEContract(t *testing.T) {
+	cases := []struct {
+		name, suffix string
+		status       int
+	}{
+		{"legacy absent", "", http.StatusOK},
+		{"legacy empty", `,"mime_type":""`, http.StatusOK},
+		{"legacy null", `,"mime_type":null`, http.StatusOK},
+		{"typed ZIP", `,"mime_type":"application/zip"`, http.StatusOK},
+		{"canonical JSON alias", `,"mimeType":"application/zip"`, http.StatusOK},
+		{"unsupported plain", `,"mime_type":"text/plain"`, http.StatusBadRequest},
+		{"unsupported case", `,"mime_type":"APPLICATION/ZIP"`, http.StatusBadRequest},
+		{"unsupported parameters", `,"mime_type":"application/zip; charset=utf-8"`, http.StatusBadRequest},
+		{"malformed object", `,"mime_type":{"value":"application/zip"}`, http.StatusInternalServerError},
+		{"malformed number", `,"mime_type":7`, http.StatusInternalServerError},
+		{"malformed boolean", `,"mime_type":true`, http.StatusInternalServerError},
+		{"malformed array", `,"mime_type":[]`, http.StatusInternalServerError},
+		{"unknown still rejected", `,"mime_type":"application/zip","future_field":"value"`, http.StatusInternalServerError},
+		{"duplicate still rejected", `,"mime_type":"application/zip","mime_type":"application/zip"`, http.StatusInternalServerError},
+		{"alias duplicate rejected", `,"mime_type":"application/zip","mimeType":"application/zip"`, http.StatusInternalServerError},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			srv, base, key := newTestServer(t)
+			token, err := common.CreateSignedAuthorizationToken(key, 7, 7, 7)
+			require.NoError(t, err)
+			body := `{"workflow_run_backend_id":"7","workflow_job_run_backend_id":"7","name":"artifact","version":7` + c.suffix + `}`
+			status, _ := doRequest(t, http.MethodPost, srv.URL+ArtifactV4RouteBase+"/CreateArtifact", token, body)
+			require.Equal(t, c.status, status)
+			_, err = os.Stat(filepath.Join(base, "7", "artifact", "artifact.zip"))
+			if c.status == http.StatusOK {
+				require.NoError(t, err)
+			} else {
+				require.True(t, os.IsNotExist(err), "rejected request must not allocate artifact")
+			}
+		})
+	}
+}
+
+func TestIdentityMIMEFieldSixWire(t *testing.T) {
+	request := &CreateArtifactRequest{MimeType: wrapperspb.String("application/zip")}
+	field := request.ProtoReflect().Descriptor().Fields().ByName("mime_type")
+	require.NotNil(t, field)
+	require.EqualValues(t, 6, field.Number())
+	require.Equal(t, "google.protobuf.StringValue", string(field.Message().FullName()))
+	encoded, err := proto.Marshal(request)
+	require.NoError(t, err)
+	expected := append([]byte{0x32, 0x11, 0x0a, 0x0f}, []byte("application/zip")...)
+	require.Equal(t, expected, encoded)
+	var parsed CreateArtifactRequest
+	require.NoError(t, proto.Unmarshal(expected, &parsed))
+	require.Equal(t, "application/zip", parsed.GetMimeType().GetValue())
+	require.NoError(t, protojson.Unmarshal([]byte(`{"mime_type":"application/zip"}`), &parsed))
+	require.Equal(t, "application/zip", parsed.GetMimeType().GetValue())
+}
+
+func TestIdentityCurrentZIPArtifactRoundTrip(t *testing.T) {
+	expected := map[string][]byte{"notes.txt": []byte("Identity local ZIP transport\n"), "media/sample.bin": {0, 1, 2, 0xff, 0x7f}}
+	var archive bytes.Buffer
+	writer := zip.NewWriter(&archive)
+	for _, name := range []string{"notes.txt", "media/sample.bin"} {
+		entry, err := writer.Create(name)
+		require.NoError(t, err)
+		_, err = entry.Write(expected[name])
+		require.NoError(t, err)
+	}
+	require.NoError(t, writer.Close())
+	digest := sha256.Sum256(archive.Bytes())
+	srv, _, key := newTestServer(t)
+	token, err := common.CreateSignedAuthorizationToken(key, 7, 7, 7)
+	require.NoError(t, err)
+	status, body := doRequest(t, http.MethodPost, srv.URL+ArtifactV4RouteBase+"/CreateArtifact", token, `{"workflow_run_backend_id":"7","workflow_job_run_backend_id":"7","name":"roundtrip","version":7,"mime_type":"application/zip"}`)
+	require.Equal(t, http.StatusOK, status)
+	var created CreateArtifactResponse
+	require.NoError(t, protojson.Unmarshal([]byte(body), &created))
+	status, _ = doRequest(t, http.MethodPut, created.SignedUploadUrl+"&comp=block", "", archive.String())
+	require.Equal(t, http.StatusCreated, status)
+	status, body = doRequest(t, http.MethodPost, srv.URL+ArtifactV4RouteBase+"/FinalizeArtifact", token, `{"workflow_run_backend_id":"7","workflow_job_run_backend_id":"7","name":"roundtrip","size":"`+strconv.FormatInt(int64(archive.Len()), 10)+`","hash":"sha256:`+hex.EncodeToString(digest[:])+`"}`)
+	require.Equal(t, http.StatusOK, status)
+	var final FinalizeArtifactResponse
+	require.NoError(t, protojson.Unmarshal([]byte(body), &final))
+	require.True(t, final.Ok)
+	status, body = doRequest(t, http.MethodPost, srv.URL+ArtifactV4RouteBase+"/GetSignedArtifactURL", token, `{"workflow_run_backend_id":"7","workflow_job_run_backend_id":"7","name":"roundtrip"}`)
+	require.Equal(t, http.StatusOK, status)
+	var signed GetSignedArtifactURLResponse
+	require.NoError(t, protojson.Unmarshal([]byte(body), &signed))
+	status, body = doRequest(t, http.MethodGet, signed.SignedUrl, "", "")
+	require.Equal(t, http.StatusOK, status)
+	require.Equal(t, digest, sha256.Sum256([]byte(body)))
+	reader, err := zip.NewReader(bytes.NewReader([]byte(body)), int64(len(body)))
+	require.NoError(t, err)
+	require.Len(t, reader.File, len(expected))
+	for _, entry := range reader.File {
+		content, err := entry.Open()
+		require.NoError(t, err)
+		data, err := io.ReadAll(content)
+		require.NoError(t, err)
+		require.NoError(t, content.Close())
+		require.Equal(t, expected[entry.Name], data)
+		delete(expected, entry.Name)
+	}
+	require.Empty(t, expected)
+}
+
+func TestIdentitySignedURLPreservesPaddingAndBindings(t *testing.T) {
+	srv, base, key := newTestServer(t)
+	token, err := common.CreateSignedAuthorizationToken(key, 7, 7, 7)
+	require.NoError(t, err)
+	status, body := doRequest(t, http.MethodPost, srv.URL+ArtifactV4RouteBase+"/CreateArtifact", token, `{"workflow_run_backend_id":"7","workflow_job_run_backend_id":"7","name":"encoded","version":7,"mime_type":"application/zip"}`)
+	require.Equal(t, http.StatusOK, status)
+	var created CreateArtifactResponse
+	require.NoError(t, protojson.Unmarshal([]byte(body), &created))
+	parsed, err := url.Parse(created.SignedUploadUrl)
+	require.NoError(t, err)
+	// The pinned Azure SDK treats an extra literal equals sign as a query
+	// delimiter. Padding must be escaped on the wire, not waived by auth.
+	parts := strings.Split(parsed.RawQuery, "&")
+	found := false
+	for _, part := range parts {
+		if strings.HasPrefix(part, "sig=") {
+			found = true
+			require.Equal(t, 1, strings.Count(part, "="))
+			require.True(t, strings.HasSuffix(part, "%3D"))
+		}
+	}
+	require.True(t, found)
+	require.True(t, strings.HasSuffix(parsed.Query().Get("sig"), "="))
+	cases := []struct {
+		name   string
+		change func(url.Values)
+	}{
+		{"missing signature", func(q url.Values) { q.Del("sig") }},
+		{"unpadded signature", func(q url.Values) { q.Set("sig", strings.TrimSuffix(q.Get("sig"), "=")) }},
+		{"changed signature", func(q url.Values) { q.Set("sig", "invalid=") }},
+		{"changed name", func(q url.Values) { q.Set("artifactName", "other") }},
+		{"changed task", func(q url.Values) { q.Set("taskID", "8") }},
+		{"changed expiry", func(q url.Values) { q.Set("expires", q.Get("expires")+" ") }},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			u := *parsed
+			q := u.Query()
+			c.change(q)
+			q.Set("comp", "block")
+			u.RawQuery = q.Encode()
+			status, _ := doRequest(t, http.MethodPut, u.String(), "", "forbidden")
+			require.Equal(t, http.StatusUnauthorized, status)
+		})
+	}
+	status, _ = doRequest(t, http.MethodPost, srv.URL+ArtifactV4RouteBase+"/CreateArtifact", "", `{"workflow_run_backend_id":"7","workflow_job_run_backend_id":"7","name":"missing-token","version":7,"mime_type":"application/zip"}`)
+	require.Equal(t, http.StatusUnauthorized, status)
+	data, err := os.ReadFile(filepath.Join(base, "7", "encoded", "encoded.zip"))
+	require.NoError(t, err)
+	require.Empty(t, data, "no failed signed request may append bytes")
+	_, err = os.Stat(filepath.Join(base, "7", "other", "other.zip"))
+	require.True(t, os.IsNotExist(err))
+	status, _ = doRequest(t, http.MethodPut, created.SignedUploadUrl+"&comp=block", "", "valid")
+	require.Equal(t, http.StatusCreated, status)
+	data, err = os.ReadFile(filepath.Join(base, "7", "encoded", "encoded.zip"))
+	require.NoError(t, err)
+	require.Equal(t, "valid", string(data))
+}
